<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>أنور أبوقصيصة - إدارة مخزن ونقطة بيع غاز الطهي</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Lucide Icons CDN -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&display=swap');
    * {
      font-family: 'Cairo', system-ui, -apple-system, sans-serif;
      -webkit-tap-highlight-color: transparent;
    }
    /* إخفاء أسهم الأرقام الافتراضية المزعجة */
    input[type=number]::-webkit-inner-spin-button, 
    input[type=number]::-webkit-outer-spin-button { 
      -webkit-appearance: none; 
      margin: 0; 
    }
    input[type=number] {
      -moz-appearance: textfield;
    }
    /* تأثير تمييز الحقل المفعل لتسهيل القراءة */
    .num-input:focus {
      background-color: #0f172a !important;
      border-color: #f59e0b !important;
      box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.35) !important;
      outline: none;
      transform: scale(1.04);
      z-index: 10;
    }
    .text-input:focus {
      border-color: #f59e0b !important;
      box-shadow: 0 0 0 2px rgba(245, 158, 11, 0.25) !important;
      outline: none;
    }
    @media print {
      .no-print { display: none !important; }
      body { background: white !important; color: black !important; }
      .print-box { border: 1px solid #ccc !important; box-shadow: none !important; background: white !important; }
    }
  </style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen pb-28 md:pb-12 selection:bg-amber-500 selection:text-slate-950">

  <!-- إشعار التنبيه العائم -->
  <div id="toast" class="fixed top-4 left-1/2 -translate-x-1/2 z-50 bg-amber-500 text-slate-950 font-black px-6 py-2.5 rounded-full shadow-2xl flex items-center gap-2 border-2 border-amber-300 transition-all duration-300 opacity-0 pointer-events-none -translate-y-5">
    <i data-lucide="info" class="w-5 h-5"></i>
    <span id="toast-text">تمت العملية بنجاح</span>
  </div>

  <!-- الهيدر وشريط الحالة العلوي -->
  <header class="bg-slate-900 border-b border-slate-800 sticky top-0 z-40 shadow-lg backdrop-blur-md bg-opacity-95 no-print">
    <div class="max-w-7xl mx-auto px-4 py-3 flex flex-wrap items-center justify-between gap-3">
      <div class="flex items-center gap-3">
        <div class="bg-gradient-to-tr from-amber-600 to-amber-400 p-2 rounded-2xl shadow-md shadow-amber-500/20 text-slate-950">
          <i data-lucide="flame" class="w-7 h-7"></i>
        </div>
        <div>
          <h1 class="text-xl md:text-2xl font-black tracking-tight text-amber-400 flex items-center gap-2">
            أنور أبوقصيصة
            <span class="text-[11px] bg-amber-500/15 text-amber-300 border border-amber-500/30 px-2 py-0.5 rounded-full font-bold">
              نقطة ومخزن غاز الطهي
            </span>
          </h1>
          <p class="text-xs text-slate-400">إدخال سلس وسريع للجرد اليومي، الورديات، والتحصيل</p>
        </div>
      </div>

      <div class="flex items-center gap-2 flex-wrap">
        <!-- اختيار التاريخ -->
        <div class="flex items-center gap-1.5 bg-slate-800 border border-slate-700 rounded-xl px-3 py-1.5 text-xs text-slate-300">
          <i data-lucide="calendar" class="w-4 h-4 text-amber-400"></i>
          <input type="date" id="currentDateInput" class="bg-transparent text-white focus:outline-none cursor-pointer text-xs" />
        </div>

        <!-- تبديل الصلاحية -->
        <button id="toggleRoleBtn" class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-bold border transition-all bg-amber-500 text-slate-950 border-amber-400 shadow-md shadow-amber-500/20">
          <i data-lucide="shield-check" class="w-4 h-4" id="roleIcon"></i>
          <span id="roleText">المالك (كامل الصلاحيات)</span>
        </button>
      </div>
    </div>

    <!-- شريط المؤشرات الحية -->
    <div class="bg-slate-900/80 border-t border-slate-800/80 px-4 py-2">
      <div class="max-w-7xl mx-auto flex items-center justify-between text-xs overflow-x-auto gap-4 py-0.5">
        <div class="flex items-center gap-1.5 shrink-0">
          <span class="text-slate-400">المباع اليوم:</span>
          <span id="headerTotalSold" class="bg-amber-500/20 text-amber-300 font-black px-2 py-0.5 rounded-md border border-amber-500/30">
            0 أسطوانة
          </span>
        </div>
        <div class="flex items-center gap-1.5 shrink-0">
          <span class="text-slate-400">ملان بالمخزن:</span>
          <span id="headerFullStock" class="bg-emerald-500/20 text-emerald-300 font-bold px-2 py-0.5 rounded-md">0</span>
        </div>
        <div class="flex items-center gap-1.5 shrink-0">
          <span class="text-slate-400">فاضي بالمخزن:</span>
          <span id="headerEmptyStock" class="bg-blue-500/20 text-blue-300 font-bold px-2 py-0.5 rounded-md">0</span>
        </div>
        <div class="flex items-center gap-1.5 shrink-0">
          <span class="text-slate-400">🏭 في شركة التعبئة:</span>
          <span id="headerAtCompany" class="bg-purple-500/20 text-purple-300 font-bold px-2 py-0.5 rounded-md">0</span>
        </div>
        <div class="flex items-center gap-1.5 shrink-0">
          <span class="text-slate-400">🔢 إجمالي الأسطوانات:</span>
          <span id="headerAllCylinders" class="bg-slate-800 text-white font-black px-2.5 py-0.5 rounded-md border border-slate-700">0</span>
        </div>
      </div>
    </div>
  </header>

  <!-- شريط التبويبات الرئيسي -->
  <nav class="max-w-7xl mx-auto px-4 mt-4 no-print">
    <div class="grid grid-cols-3 sm:grid-cols-7 gap-1.5 bg-slate-900 p-1.5 rounded-2xl border border-slate-800">
      <button onclick="switchTab('inventory')" class="tab-btn flex items-center justify-center gap-1.5 py-2.5 px-2 rounded-xl text-xs font-bold transition-all bg-amber-500 text-slate-950 shadow-md shadow-amber-500/20" data-tab="inventory">
        <i data-lucide="package" class="w-4 h-4"></i>
        <span>جرد الغاز والتعبئة</span>
      </button>

      <button onclick="switchTab('accessories')" class="tab-btn flex items-center justify-center gap-1.5 py-2.5 px-2 rounded-xl text-xs font-bold transition-all text-slate-400 hover:bg-slate-800/60" data-tab="accessories">
        <i data-lucide="gauge" class="w-4 h-4"></i>
        <span>المنظم والخرطوش</span>
      </button>

      <button onclick="switchTab('swaps')" class="tab-btn flex items-center justify-center gap-1.5 py-2.5 px-2 rounded-xl text-xs font-bold transition-all text-slate-400 hover:bg-slate-800/60" data-tab="swaps">
        <i data-lucide="arrow-right-left" class="w-4 h-4"></i>
        <span>التبديل والأمانات</span>
      </button>

      <button onclick="switchTab('collections')" class="tab-btn flex items-center justify-center gap-1.5 py-2.5 px-2 rounded-xl text-xs font-bold transition-all text-slate-400 hover:bg-slate-800/60 relative" data-tab="collections">
        <i data-lucide="receipt" class="w-4 h-4"></i>
        <span>التحصيل والآجل</span>
        <span id="unpaidBadge" class="hidden absolute top-1 right-2 bg-rose-500 text-white text-[9px] w-4 h-4 rounded-full flex items-center justify-center font-bold">0</span>
      </button>

      <button onclick="switchTab('expenses')" class="tab-btn flex items-center justify-center gap-1.5 py-2.5 px-2 rounded-xl text-xs font-bold transition-all text-slate-400 hover:bg-slate-800/60" data-tab="expenses">
        <i data-lucide="dollar-sign" class="w-4 h-4"></i>
        <span>المنصرفات</span>
      </button>

      <button onclick="switchTab('report')" class="tab-btn flex items-center justify-center gap-1.5 py-2.5 px-2 rounded-xl text-xs font-bold transition-all text-slate-400 hover:bg-slate-800/60" data-tab="report">
        <i data-lucide="file-text" class="w-4 h-4"></i>
        <span>التقرير المالي</span>
      </button>

      <button onclick="switchTab('history')" class="tab-btn flex items-center justify-center gap-1.5 py-2.5 px-2 rounded-xl text-xs font-bold transition-all text-slate-400 hover:bg-slate-800/60 col-span-3 sm:col-span-1" data-tab="history">
        <i data-lucide="clock" class="w-4 h-4"></i>
        <span>الأرشيف</span>
      </button>
    </div>
  </nav>

  <!-- المحتوى الرئيسي -->
  <main class="max-w-7xl mx-auto px-4 mt-6">

    <!-- ============================================================= -->
    <!-- 1. صفحة جرد الغاز الثابت، الورديات، والتعبئة -->
    <!-- ============================================================= -->
    <section id="tab-inventory" class="space-y-6">
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
        <div>
          <h2 class="text-base md:text-lg font-bold text-white flex items-center gap-2">
            <i data-lucide="layers" class="w-5 h-5 text-amber-400"></i>
            جدول جرد الغاز الثابت، الورديات، وأسطوانات شركة التعبئة
          </h2>
          <p class="text-xs text-slate-400 mt-1">
            ⚡ <strong>تسهيل الإدخال:</strong> بمجرد لمس أي رقم يتم تظليله تلقائياً لكتابة القيمة الجديدة مباشرة، وتفتح لوحة الأرقام الكبيرة على هاتفك.
          </p>
        </div>

        <button onclick="rollOverToNextDay()" class="w-full md:w-auto bg-slate-800 hover:bg-slate-700 text-amber-300 border border-amber-500/30 px-4 py-2.5 rounded-xl text-xs font-bold flex items-center justify-center gap-2 transition active:scale-95">
          <i data-lucide="rotate-ccw" class="w-4 h-4"></i>
          ترحيل الأرصدة لبدء يوم جديد
        </button>
      </div>

      <!-- الفلاتر والبحث -->
      <div class="flex flex-col sm:flex-row items-center justify-between gap-3">
        <div class="flex items-center gap-1.5 overflow-x-auto w-full sm:w-auto pb-1" id="categoryFilters">
          <button onclick="setCategoryFilter('الكل')" class="cat-filter-btn px-3 py-1.5 rounded-xl text-xs font-black bg-amber-500 text-slate-950" data-cat="الكل">الكل</button>
          <button onclick="setCategoryFilter('عادي')" class="cat-filter-btn px-3 py-1.5 rounded-xl text-xs font-bold bg-slate-900 text-slate-400 hover:bg-slate-800 border border-slate-800" data-cat="عادي">عادي</button>
          <button onclick="setCategoryFilter('45 كجم')" class="cat-filter-btn px-3 py-1.5 rounded-xl text-xs font-bold bg-slate-900 text-slate-400 hover:bg-slate-800 border border-slate-800" data-cat="45 كجم">45 كجم</button>
          <button onclick="setCategoryFilter('25 كجم')" class="cat-filter-btn px-3 py-1.5 rounded-xl text-xs font-bold bg-slate-900 text-slate-400 hover:bg-slate-800 border border-slate-800" data-cat="25 كجم">25 كجم</button>
          <button onclick="setCategoryFilter('5 كجم')" class="cat-filter-btn px-3 py-1.5 rounded-xl text-xs font-bold bg-slate-900 text-slate-400 hover:bg-slate-800 border border-slate-800" data-cat="5 كجم">5 كجم</button>
        </div>

        <div class="relative w-full sm:w-72">
          <i data-lucide="search" class="w-4 h-4 text-slate-400 absolute right-3 top-1/2 -translate-y-1/2"></i>
          <input type="text" id="inventorySearch" oninput="renderInventoryTable()" placeholder="بحث سريع عن صنف..." class="text-input w-full bg-slate-900 border border-slate-800 rounded-xl pr-9 pl-3 py-2 text-xs text-white placeholder-slate-500 focus:outline-none transition" />
        </div>
      </div>

      <!-- جدول الجرد المحسن للإدخال السلس -->
      <div class="bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden shadow-xl">
        <div class="overflow-x-auto">
          <table class="w-full text-right border-collapse min-w-[1020px]">
            <thead>
              <tr class="bg-slate-950/90 text-slate-400 text-xs border-b border-slate-800 font-bold select-none">
                <th class="p-3 w-10 text-center">#</th>
                <th class="p-3">الصنف</th>
                <th class="p-2 text-center text-emerald-400 bg-emerald-950/20">ملان (بداية)</th>
                <th class="p-2 text-center text-blue-400 bg-blue-950/20">فاضي (بداية)</th>
                <th class="p-2 text-center text-purple-400 bg-purple-950/20">في الشركة (بداية)</th>
                <th class="p-2 text-center text-amber-300 bg-amber-500/10">مباع و (1)</th>
                <th class="p-2 text-center text-amber-300 bg-amber-500/10">مباع و (2)</th>
                <th class="p-2 text-center text-emerald-300 bg-emerald-900/30">وارد ملان (شركة)</th>
                <th class="p-2 text-center text-rose-300 bg-rose-950/30">مرسل فاضي (شركة)</th>
                <th class="p-3 text-center font-black text-amber-400">إجمالي المباع</th>
                <th class="p-2 text-center text-emerald-400 bg-emerald-950/30">ملان حالي</th>
                <th class="p-2 text-center text-blue-400 bg-blue-950/30">فاضي حالي</th>
                <th class="p-2 text-center text-purple-300 bg-purple-950/30">في الشركة الآن</th>
                <th class="p-3 text-center font-black text-white">العدد الكلي</th>
              </tr>
            </thead>
            <tbody id="inventoryTableBody" class="divide-y divide-slate-800/60 text-xs">
              <!-- ينشأ برمجياً بواسطة JavaScript -->
            </tbody>
            <tfoot id="inventoryTableFoot" class="bg-slate-950 font-black text-white text-xs border-t-2 border-slate-700">
              <!-- مجاميع الجدول -->
            </tfoot>
          </table>
        </div>
      </div>
    </section>

    <!-- ============================================================= -->
    <!-- 2. صفحة جرد المنظمات وبيع الخرطوش بالمتر -->
    <!-- ============================================================= -->
    <section id="tab-accessories" class="space-y-6 hidden">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        
        <!-- قسم جرد أجهزة المنظمات -->
        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 space-y-4">
          <div class="flex items-center justify-between border-b border-slate-800 pb-3">
            <h3 class="font-bold text-white text-base flex items-center gap-2">
              <i data-lucide="gauge" class="w-5 h-5 text-amber-400"></i>
              جرد ومبيعات أجهزة المنظمات
            </h3>
            <span id="regSoldBadge" class="text-xs bg-amber-500/10 text-amber-300 px-2 py-0.5 rounded-md font-bold">0 حبة</span>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full text-right text-xs border-collapse">
              <thead>
                <tr class="bg-slate-950 text-slate-400 border-b border-slate-800 font-bold select-none">
                  <th class="p-2.5">نوع المنظم</th>
                  <th class="p-2 text-center">رصيد البداية</th>
                  <th class="p-2 text-center">وارد جديد</th>
                  <th class="p-2 text-center">مباع و (1)</th>
                  <th class="p-2 text-center">مباع و (2)</th>
                  <th class="p-2 text-center">المتبقي</th>
                  <th class="p-2 text-center">السعر</th>
                </tr>
              </thead>
              <tbody id="regulatorsTableBody" class="divide-y divide-slate-800">
                <!-- ينشأ برمجياً -->
              </tbody>
            </table>
          </div>

          <div class="bg-slate-950 p-3 rounded-xl border border-slate-800 flex items-center justify-between text-xs">
            <span class="text-slate-400">إجمالي إيراد بيع المنظمات:</span>
            <span id="totalRegRevenueText" class="text-amber-400 font-black text-sm">0 ج.س</span>
          </div>
        </div>

        <!-- قسم بيع خرطوش الغاز بالمتر -->
        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 space-y-4">
          <div class="flex items-center justify-between border-b border-slate-800 pb-3">
            <h3 class="font-bold text-white text-base flex items-center gap-2">
              <i data-lucide="ruler" class="w-5 h-5 text-amber-400"></i>
              جرد وبيع خرطوش الغاز (بالمتر)
            </h3>
            <span id="hoseRemainingBadge" class="text-xs bg-emerald-500/10 text-emerald-400 px-2 py-0.5 rounded-md font-bold">0 متر متبقي</span>
          </div>

          <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 text-xs">
            <div class="bg-slate-950 p-3 rounded-xl border border-slate-800">
              <label class="block text-slate-400 mb-1 font-semibold">رصيد البداية (متر)</label>
              <input type="number" id="hoseInitMeters" onfocus="this.select()" inputmode="numeric" oninput="updateHoseData()" min="0" class="num-input w-full bg-slate-900 border border-slate-700 rounded-lg p-2 text-white font-bold text-sm text-center" />
            </div>

            <div class="bg-slate-950 p-3 rounded-xl border border-slate-800">
              <label class="block text-slate-400 mb-1 font-semibold">وارد رول جديد (متر)</label>
              <input type="number" id="hoseAddedMeters" onfocus="this.select()" inputmode="numeric" oninput="updateHoseData()" min="0" class="num-input w-full bg-slate-900 border border-slate-700 rounded-lg p-2 text-emerald-400 font-bold text-sm text-center" />
            </div>

            <div class="bg-slate-950 p-3 rounded-xl border border-slate-800">
              <label class="block text-slate-400 mb-1 font-semibold">سعر المتر (ج.س)</label>
              <input type="number" id="hosePricePerMeter" onfocus="this.select()" inputmode="numeric" oninput="updateHoseData()" min="0" class="num-input w-full bg-slate-900 border border-slate-700 rounded-lg p-2 text-amber-400 font-bold text-sm text-center" />
            </div>

            <div class="bg-slate-950 p-3 rounded-xl border border-amber-500/20">
              <label class="block text-amber-300 mb-1 font-semibold">مباع وردية 1 (متر)</label>
              <input type="number" id="hoseShift1Meters" onfocus="this.select()" inputmode="numeric" oninput="updateHoseData()" min="0" class="num-input w-full bg-slate-900 border border-amber-500/40 rounded-lg p-2 text-amber-300 font-bold text-sm text-center" />
            </div>

            <div class="bg-slate-950 p-3 rounded-xl border border-amber-500/20">
              <label class="block text-amber-300 mb-1 font-semibold">مباع وردية 2 (متر)</label>
              <input type="number" id="hoseShift2Meters" onfocus="this.select()" inputmode="numeric" oninput="updateHoseData()" min="0" class="num-input w-full bg-slate-900 border border-amber-500/40 rounded-lg p-2 text-amber-300 font-bold text-sm text-center" />
            </div>

            <div class="bg-slate-950 p-3 rounded-xl border border-slate-800">
              <label class="block text-slate-400 mb-1 font-semibold">إجمالي المباع بالمتر</label>
              <div id="hoseTotalSoldText" class="text-base font-black text-amber-400 py-1 text-center">0 متر</div>
            </div>
          </div>

          <div class="bg-slate-950 p-3 rounded-xl border border-slate-800 flex items-center justify-between text-xs">
            <span class="text-slate-400">إجمالي إيراد بيع الخرطوش اليوم:</span>
            <span id="hoseTotalRevenueText" class="text-amber-400 font-black text-sm">0 ج.س</span>
          </div>
        </div>

      </div>
    </section>

    <!-- ============================================================= -->
    <!-- 3. صفحة تبديل أسطوانة بماركة أخرى + الأمانات ومسبق الدفع -->
    <!-- ============================================================= -->
    <section id="tab-swaps" class="space-y-6 hidden">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

        <!-- استبدال الماركات -->
        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 space-y-4">
          <div class="border-b border-slate-800 pb-3">
            <h3 class="font-bold text-white text-base flex items-center gap-2">
              <i data-lucide="arrow-right-left" class="w-5 h-5 text-amber-400"></i>
              تبديل نوع أسطوانة بنوع آخر (استبدال الأصناف)
            </h3>
            <p class="text-xs text-slate-400 mt-0.5">
              خرج ملان نوع (أ) ودخل فاضي نوع (ب). التطبيق يقوم بضبط الأرصدة تلقائياً لكل نوع.
            </p>
          </div>

          <form id="swapForm" onsubmit="handleSwapSubmit(event)" class="space-y-3.5 text-xs">
            <div>
              <label class="block text-slate-400 mb-1 font-semibold">اسم الزبون / الملاحظة</label>
              <input type="text" id="swapCustomer" placeholder="اسم الزبون..." class="text-input w-full bg-slate-950 border border-slate-700 rounded-xl p-2.5 text-white" />
            </div>

            <div class="grid grid-cols-2 gap-2">
              <div>
                <label class="block text-rose-400 mb-1 font-semibold">خارج ملان من المخزن *</label>
                <select id="swapOutCylinder" class="w-full bg-slate-950 border border-slate-700 rounded-xl p-2.5 text-white"></select>
              </div>

              <div>
                <label class="block text-emerald-400 mb-1 font-semibold">داخل فاضي للمخزن *</label>
                <select id="swapInCylinder" class="w-full bg-slate-950 border border-slate-700 rounded-xl p-2.5 text-white"></select>
              </div>
            </div>

            <div class="grid grid-cols-3 gap-2">
              <div>
                <label class="block text-slate-400 mb-1 font-semibold">العدد</label>
