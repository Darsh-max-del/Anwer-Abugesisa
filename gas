    function handleSwapSubmit(e) {
      e.preventDefault();
      const customer = document.getElementById('swapCustomer')?.value.trim() || 'زبون عام';
      const outCyl = document.getElementById('swapOutCylinder')?.value;
      const inCyl = document.getElementById('swapInCylinder')?.value;
      const qty = parseInt(document.getElementById('swapQty')?.value) || 1;
      const fee = Number(document.getElementById('swapDifferenceFee')?.value) || 0;
      const shift = document.getElementById('swapShift')?.value || '1';

      const outItem = CYLINDER_DEFINITIONS.find(c => c.name === outCyl);
      const inItem = CYLINDER_DEFINITIONS.find(c => c.name === inCyl);

      if (outItem && inItem) {
        appState.inventory[outItem.id].swapOut = (appState.inventory[outItem.id].swapOut || 0) + qty;
        appState.inventory[inItem.id].swapIn = (appState.inventory[inItem.id].swapIn || 0) + qty;
      }

      appState.swaps.unshift({
        id: 'sw-' + Date.now(),
        date: appState.currentDate,
        customer,
        outCylinder: outCyl,
        inCylinder: inCyl,
        qty,
        differenceFee: fee,
        shift
      });

      document.getElementById('swapCustomer').value = '';
      showToast(`🔄 تم تسجيل التبديل: خرج (${outCyl}) ودخل (${inCyl})`);
      recalculateAndRender(true);
    }

    function handleSpecialSubmit(e) {
      e.preventDefault();
      const type = document.getElementById('specialType')?.value;
      const customer = document.getElementById('specialCustomer')?.value.trim() || 'بدون اسم';
      const cylName = document.getElementById('specialCylinderType')?.value;
      const qty = parseInt(document.getElementById('specialQty')?.value) || 1;
      const notes = document.getElementById('specialNotes')?.value.trim() || '';

      const item = CYLINDER_DEFINITIONS.find(c => c.name === cylName);
      if (item) {
        if (type === 'prepaid_delivery') {
          appState.inventory[item.id].prepaidSold = (appState.inventory[item.id].prepaidSold || 0) + qty;
        } else if (type === 'empty_deposit') {
          appState.inventory[item.id].swapIn = (appState.inventory[item.id].swapIn || 0) + qty;
        }
      }

      appState.specials.unshift({
        id: 'sp-' + Date.now(),
        date: appState.currentDate,
        type,
        customer,
        cylinderType: cylName,
        qty,
        notes
      });

      document.getElementById('specialCustomer').value = '';
      document.getElementById('specialNotes').value = '';
      showToast('✅ تم تسجيل الحركة بنجاح وضبط رصيد الأسطوانات');
