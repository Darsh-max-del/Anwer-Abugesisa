    // تحديث الواجهة العامة مع الحفاظ على تركيز المؤشر أثناء الكتابة السريعة
    function recalculateAndRender(fullRebuild = false) {
      const totals = calculateTotals();

      document.getElementById('headerTotalSold').innerText = `${totals.totalSoldAll} أسطوانة`;
      document.getElementById('headerFullStock').innerText = totals.totalCurrentFull;
      document.getElementById('headerEmptyStock').innerText = totals.totalCurrentEmpty;
      document.getElementById('headerAtCompany').innerText = totals.totalAtCompany;
      document.getElementById('headerAllCylinders').innerText = totals.totalAllCylinders;

      const unpaidCount = appState.collections.filter(c => !c.paid).length;
      const unpaidBadge = document.getElementById('unpaidBadge');
      if (unpaidBadge) {
        unpaidBadge.innerText = unpaidCount;
        unpaidBadge.style.display = unpaidCount > 0 ? 'flex' : 'none';
      }

      if (fullRebuild) {
        renderInventoryTable();
        renderRegulatorsTable();
      } else {
        // تحديث الخلايا المحسوبة فقط لمنع إغلاق لوحة المفاتيح أثناء الكتابة السريعة
        CYLINDER_DEFINITIONS.forEach(item => {
          const d = appState.inventory[item.id] || { initFull:0, initEmpty:0, atCompany:0, shift1Sold:0, shift2Sold:0, prepaidSold:0, receivedFull:0, sentEmpty:0, swapOut:0, swapIn:0 };
          const regSold = (d.shift1Sold || 0) + (d.shift2Sold || 0);
          const totalSoldWithPrepaid = regSold + (d.prepaidSold || 0);
          const curFull = Math.max(0, (d.initFull || 0) + (d.receivedFull || 0) - (totalSoldWithPrepaid + (d.swapOut || 0)));
          const curEmpty = Math.max(0, (d.initEmpty || 0) + regSold + (d.swapIn || 0) - (d.sentEmpty || 0));
          const curAtCompany = Math.max(0, (d.atCompany || 0) + (d.sentEmpty || 0) - (d.receivedFull || 0));
          const totalItemCount = curFull + curEmpty + curAtCompany;

          const fCell = document.getElementById(`cell-curFull-${item.id}`);
          if (fCell) fCell.innerText = curFull;
          const eCell = document.getElementById(`cell-curEmpty-${item.id}`);
          if (eCell) eCell.innerText = curEmpty;
          const compCell = document.getElementById(`cell-curCompany-${item.id}`);
          if (compCell) compCell.innerText = curAtCompany;
          const totCell = document.getElementById(`cell-totalCount-${item.id}`);
          if (totCell) totCell.innerText = totalItemCount;
        });
        updateInventoryFootTotals();
      }

      document.getElementById('regSoldBadge').innerText = `${totals.totalRegSold} حبة مباعة`;
      document.getElementById('totalRegRevenueText').innerText = `${totals.totalRegRevenue.toLocaleString()} ج.س`;
      document.getElementById('hoseRemainingBadge').innerText = `${totals.hoseRemaining} متر متبقي`;
      document.getElementById('hoseTotalSoldText').innerText = `${totals.hoseSold} متر`;
      document.getElementById('hoseTotalRevenueText').innerText = `${totals.hoseRevenue.toLocaleString()} ج.س`;

      if (document.getElementById('hoseInitMeters') && document.activeElement !== document.getElementById('hoseInitMeters')) {
        document.getElementById('hoseInitMeters').value = appState.hose.initMeters;
      }
      if (document.getElementById('hoseAddedMeters') && document.activeElement !== document.getElementById('hoseAddedMeters')) {
        document.getElementById('hoseAddedMeters').value = appState.hose.addedMeters;
      }
      if (document.getElementById('hosePricePerMeter') && document.activeElement !== document.getElementById('hosePricePerMeter')) {
        document.getElementById('hosePricePerMeter').value = appState.hose.pricePerMeter;
      }
      if (document.getElementById('hoseShift1Meters') && document.activeElement !== document.getElementById('hoseShift1Meters')) {
        document.getElementById('hoseShift1Meters').value = appState.hose.shift1Meters;
      }
      if (document.getElementById('hoseShift2Meters') && document.activeElement !== document.getElementById('hoseShift2Meters')) {
        document.getElementById('hoseShift2Meters').value = appState.hose.shift2Meters;
      }

      const swapLogsDiv = document.getElementById('swapLogsList');
      if (swapLogsDiv) {
        swapLogsDiv.innerHTML = appState.swaps.map(s => `
          <div class="bg-slate-950 p-2.5 rounded-xl border border-slate-800 flex items-center justify-between text-xs">
            <div>
              <div class="font-bold text-white flex items-center gap-1.5">
                <span class="text-rose-400">خارج ملان: ${s.outCylinder}</span>
                <span class="text-slate-500">⇄</span>
                <span class="text-emerald-400">داخل فاضي: ${s.inCylinder}</span>
                <span class="text-slate-400">(${s.qty})</span>
              </div>
              <div class="text-[10px] text-slate-500 mt-0.5">
                ${s.customer} • وردية ${s.shift} ${s.differenceFee > 0 ? `• فرق: ${s.differenceFee} ج.س` : ''}
              </div>
            </div>
          </div>
        `).join('') || '<div class="text-slate-500 text-center py-4 text-xs">لا توجد عمليات تبديل مسجلة</div>';
      }

      const specialLogsDiv = document.getElementById('specialLogsList');
      if (specialLogsDiv) {
        specialLogsDiv.innerHTML = appState.specials.map(sp => `
          <div class="bg-slate-950 p-2.5 rounded-xl border border-slate-800 flex items-center justify-between text-xs">
            <div>
              <div class="font-bold text-white flex items-center gap-1.5">
                <span>${sp.type === 'prepaid_delivery' ? '🏷️ مسبق الدفع:' : '📥 أمانة فاضي:'}</span>
                <span class="text-amber-300">${sp.cylinderType} (${sp.qty})</span>
              </div>
              <div class="text-[10px] text-slate-400 mt-0.5">${sp.customer} ${sp.notes ? `• ${sp.notes}` : ''}</div>
            </div>
          </div>
        `).join('') || '<div class="text-slate-500 text-center py-4 text-xs">لا توجد حركات أمانة مسجلة</div>';
      }

      document.getElementById('statTotalUnpaid').innerText = `${totals.totalAllUnpaid.toLocaleString()} ج.س`;
      document.getElementById('statNewDebtToday').innerText = `${totals.newDebtToday.toLocaleString()} ج.س`;
      document.getElementById('statCollectedToday').innerText = `${totals.collectedToday.toLocaleString()} ج.س`;

      const colListDiv = document.getElementById('collectionsList');
      if (colListDiv) {
        colListDiv.innerHTML = appState.collections.map(col => `
          <div class="p-4 transition-all flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 ${col.paid ? 'bg-slate-950/40 opacity-75' : 'hover:bg-slate-800/40'}">
            <div class="space-y-1">
              <div class="flex items-center gap-2">
                <span class="font-bold text-sm ${col.paid ? 'line-through text-slate-400' : 'text-white'}">${col.customer}</span>
                ${col.paid ? `
                  <span class="bg-emerald-500/20 text-emerald-400 text-[10px] font-bold px-2 py-0.5 rounded-full border border-emerald-500/30">
                    تم الشطب والسداد (${col.paidDate})
                  </span>
                ` : `
                  <span class="bg-rose-500/20 text-rose-400 text-[10px] font-bold px-2 py-0.5 rounded-full border border-rose-500/30">معلق</span>
                `}
              </div>
              <div class="text-xs text-slate-400 flex flex-wrap items-center gap-3">
                <span>📅 ${col.date}</span>
                <span>📦 ${col.cylinderType} (${col.qty})</span>
                ${col.phone !== '---' ? `<span>📞 ${col.phone}</span>` : ''}
                ${col.notes ? `<span class="text-amber-300/80">📝 ${col.notes}</span>` : ''}
              </div>
            </div>
            <div class="flex items-center gap-3 w-full sm:w-auto justify-between sm:justify-end border-t sm:border-t-0 pt-2 sm:pt-0 border-slate-800">
              <span class="text-base font-black ${col.paid ? 'line-through text-slate-500' : 'text-amber-400'}">${col.amount.toLocaleString()} ج.س</span>
              <div class="flex items-center gap-1.5">
                <button onclick="toggleCollectionPaid('${col.id}')" class="px-3 py-1.5 rounded-xl text-xs font-bold transition flex items-center gap-1 ${col.paid ? 'bg-slate-800 text-slate-300 hover:bg-slate-700' : 'bg-emerald-600 hover:bg-emerald-500 text-white shadow-md active:scale-95'}">
                  ${col.paid ? 'إلغاء الشطب' : 'شطب (دفع)'}
                </button>
                ${appState.userRole === 'owner' ? `
                  <button onclick="deleteCollection('${col.id}')" class="p-1.5 text-slate-500 hover:text-rose-400 hover:bg-rose-500/10 rounded-lg transition">
                    <i data-lucide="trash-2" class="w-4 h-4"></i>
                  </button>
                ` : ''}
              </div>
            </div>
          </div>
        `).join('') || '<div class="p-8 text-center text-slate-500 text-xs">لا توجد فواتير آجلة مسجلة</div>';
      }

      document.getElementById('statTotalExpenses').innerText = `${totals.expensesTotal.toLocaleString()} ج.س`;
      const expListDiv = document.getElementById('expensesList');
      if (expListDiv) {
        const todayExp = appState.expenses.filter(e => e.date === appState.currentDate);
        expListDiv.innerHTML = todayExp.map(exp => `
          <div class="p-4 hover:bg-slate-800/40 transition flex items-center justify-between gap-3">
            <div class="space-y-1">
              <div class="flex items-center gap-2">
                <span class="font-bold text-sm text-white">${exp.title}</span>
                <span class="bg-slate-800 text-slate-300 text-[10px] px-2 py-0.5 rounded-md">${exp.category}</span>
                <span class="bg-amber-500/10 text-amber-300 text-[10px] px-2 py-0.5 rounded-md">وردية ${exp.shift}</span>
              </div>
              ${exp.notes ? `<p class="text-xs text-slate-400">${exp.notes}</p>` : ''}
            </div>
            <div class="flex items-center gap-3">
              <span class="text-base font-black text-rose-400">-${exp.amount.toLocaleString()} ج.س</span>
              <button onclick="deleteExpense('${exp.id}')" class="p-1.5 text-slate-500 hover:text-rose-400 hover:bg-rose-500/10 rounded-lg transition">
                <i data-lucide="trash-2" class="w-4 h-4"></i>
              </button>
            </div>
          </div>
        `).join('') || '<div class="p-8 text-center text-slate-500 text-xs">لم يتم تسجيل منصرفات لليوم</div>';
      }

      document.getElementById('repGasRevenue').innerText = `${totals.totalGasRevenue.toLocaleString()} ج.س`;
      document.getElementById('repGasSoldSubtitle').innerText = `${totals.totalSoldAll} أسطوانة مباعة`;
      document.getElementById('repAccessoriesRevenue').innerText = `${(totals.totalRegRevenue + totals.hoseRevenue + totals.swapFees).toLocaleString()} ج.س`;
      document.getElementById('repElectronicTotal').innerText = `${totals.electronic.toLocaleString()} ج.س`;
      document.getElementById('repExpensesAndDebts').innerText = `${(totals.expensesTotal + totals.newDebtToday).toLocaleString()} ج.س`;
      document.getElementById('repExpensesSubtitle').innerText = `منصرفات: ${totals.expensesTotal.toLocaleString()} ج.س`;

      document.getElementById('repExpectedCash').innerText = `${totals.expectedCash.toLocaleString()} ج.س`;
      document.getElementById('repActualCash').innerText = `${totals.actualCash.toLocaleString()} ج.س`;
      document.getElementById('repNetIncome').innerText = `${totals.netIncome.toLocaleString()} ج.س`;

      const discBox = document.getElementById('discrepancyBox');
      const discTitle = document.getElementById('discrepancyTitle');
      if (discBox && discTitle) {
        if (totals.discrepancy === 0) {
          discBox.className = 'p-6 rounded-2xl border-2 transition-all bg-emerald-950/20 border-emerald-500/50 print-box';
          discTitle.innerHTML = `<i data-lucide="check-circle-2" class="w-8 h-8 text-emerald-400"></i> <span class="text-emerald-400">مطابقة تامة 100% (صفر عجز)</span>`;
        } else if (totals.discrepancy > 0) {
          discBox.className = 'p-6 rounded-2xl border-2 transition-all bg-blue-950/20 border-blue-500/50 print-box';
          discTitle.innerHTML = `<i data-lucide="trending-up" class="w-8 h-8 text-blue-400"></i> <span class="text-blue-400">فائض في الخزينة: +${totals.discrepancy.toLocaleString()} ج.س</span>`;
        } else {
          discBox.className = 'p-6 rounded-2xl border-2 transition-all bg-rose-950/20 border-rose-500/50 print-box';
          discTitle.innerHTML = `<i data-lucide="alert-circle" class="w-8 h-8 text-rose-400"></i> <span class="text-rose-400">عجز نقدي بالدرج: ${totals.discrepancy.toLocaleString()} ج.س</span>`;
        }
      }

      const archiveDiv = document.getElementById('savedReportsList');
      if (archiveDiv) {
        archiveDiv.innerHTML = appState.savedReports.map(rep => `
          <div class="bg-slate-950 border border-slate-800 p-4 rounded-xl flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
            <div>
              <div class="flex items-center gap-2">
                <span class="font-bold text-white text-base">تقرير يوم: ${rep.date}</span>
                <span class="text-[10px] bg-slate-800 text-slate-400 px-2 py-0.5 rounded-md">حُفظ الساعة ${rep.savedAt}</span>
              </div>
              <div class="text-xs text-slate-400 mt-1 flex flex-wrap gap-4">
                <span>📦 غاز: ${rep.totals.totalSoldAll}</span>
                <span>🎛️ منظمات: ${rep.totals.totalRegSold}</span>
                <span>📏 خرطوش: ${rep.totals.hoseSold} متر</span>
                <span>💰 الإجمالي: ${rep.totals.totalGrossRevenue.toLocaleString()} ج.س</span>
                <span>💵 كاش: ${rep.totals.actualCash.toLocaleString()} ج.س</span>
              </div>
            </div>
            <span class="text-xs font-bold px-2.5 py-1 rounded-lg ${rep.totals.discrepancy === 0 ? 'bg-emerald-500/20 text-emerald-400 border border-emerald-500/30' : 'bg-rose-500/20 text-rose-400 border border-rose-500/30'}">
              ${rep.totals.discrepancy === 0 ? 'مطابق 100%' : `عجز/فائض: ${rep.totals.discrepancy.toLocaleString()}`}
            </span>
          </div>
        `).join('') || '<div class="p-12 text-center text-slate-500 text-xs">لم يتم حفظ تقارير يومية بعد</div>';
      }

      if (window.lucide) {
        lucide.createIcons();
      }
    }

    window.addEventListener('DOMContentLoaded', () => {
      initDefaultData();

      const dateInput = document.getElementById('currentDateInput');
      if (dateInput) {
        dateInput.value = appState.currentDate;
        dateInput.addEventListener('change', (e) => {
          appState.currentDate = e.target.value;
          recalculateAndRender(true);
        });
      }

      if (document.getElementById('payBankak')) document.getElementById('payBankak').value = appState.payments.bankak;
      if (document.getElementById('payFawry')) document.getElementById('payFawry').value = appState.payments.fawry;
      if (document.getElementById('payOcash')) document.getElementById('payOcash').value = appState.payments.ocash;
      if (document.getElementById('payActualCash')) document.getElementById('payActualCash').value = appState.payments.actualCash;

      const toggleRoleBtn = document.getElementById('toggleRoleBtn');
      if (toggleRoleBtn) {
        toggleRoleBtn.addEventListener('click', () => {
          appState.userRole = appState.userRole === 'owner' ? 'worker' : 'owner';
          const isOwner = appState.userRole === 'owner';
          document.getElementById('roleText').innerText = isOwner ? 'المالك (كامل الصلاحيات)' : 'عامل الوردية';
          toggleRoleBtn.className = `flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-bold border transition-all ${isOwner ? 'bg-amber-500 text-slate-950 border-amber-400 shadow-md shadow-amber-500/20' : 'bg-emerald-600 text-white border-emerald-500'}`;
          showToast(`تم التبديل إلى وضع: ${isOwner ? 'المالك (أنور)' : 'عامل الوردية'}`);
          recalculateAndRender(true);
        });
      }

      populateDropdowns();
      recalculateAndRender(true);
    });
  </script>
</body>
</html>
