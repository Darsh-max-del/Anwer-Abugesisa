    function rollOverToNextDay() {
      CYLINDER_DEFINITIONS.forEach(item => {
        const d = appState.inventory[item.id] || { initFull:0, initEmpty:0, atCompany:0, shift1Sold:0, shift2Sold:0, prepaidSold:0, receivedFull:0, sentEmpty:0, swapOut:0, swapIn:0 };
        const regSold = (d.shift1Sold || 0) + (d.shift2Sold || 0);
        const totalSoldWithPrepaid = regSold + (d.prepaidSold || 0);

        const endFull = Math.max(0, (d.initFull || 0) + (d.receivedFull || 0) - (totalSoldWithPrepaid + (d.swapOut || 0)));
        const endEmpty = Math.max(0, (d.initEmpty || 0) + regSold + (d.swapIn || 0) - (d.sentEmpty || 0));
        const endAtCompany = Math.max(0, (d.atCompany || 0) + (d.sentEmpty || 0) - (d.receivedFull || 0));

        appState.inventory[item.id] = {
          initFull: endFull,
          initEmpty: endEmpty,
          atCompany: endAtCompany,
          shift1Sold: 0,
          shift2Sold: 0,
          prepaidSold: 0,
          receivedFull: 0,
          sentEmpty: 0,
          swapOut: 0,
          swapIn: 0,
          price: d.price || item.defaultPrice
        };
      });

      REGULATOR_DEFINITIONS.forEach(r => {
        const d = appState.regulators[r.id] || { initStock: 0, added: 0, shift1Sold: 0, shift2Sold: 0, price: r.price };
        const s = (d.shift1Sold || 0) + (d.shift2Sold || 0);
        appState.regulators[r.id] = {
          initStock: Math.max(0, (d.initStock || 0) + (d.added || 0) - s),
          added: 0,
          shift1Sold: 0,
          shift2Sold: 0,
          price: d.price || r.price
        };
      });

      const totals = calculateTotals();
      appState.hose.initMeters = totals.hoseRemaining;
      appState.hose.addedMeters = 0;
      appState.hose.shift1Meters = 0;
      appState.hose.shift2Meters = 0;

      appState.payments = { bankak: 0, fawry: 0, ocash: 0, actualCash: 0 };
      if (document.getElementById('payBankak')) document.getElementById('payBankak').value = '';
      if (document.getElementById('payFawry')) document.getElementById('payFawry').value = '';
      if (document.getElementById('payOcash')) document.getElementById('payOcash').value = '';
      if (document.getElementById('payActualCash')) document.getElementById('payActualCash').value = '';

      const d = new Date(appState.currentDate);
      d.setDate(d.getDate() + 1);
      appState.currentDate = d.toISOString().split('T')[0];
      document.getElementById('currentDateInput').value = appState.currentDate;

      showToast('🚀 تم تدوير الأرصدة وبدء يوم جديد');
      recalculateAndRender(true);
    }

