    // تعديل قيمة الغاز
    function onGasFieldChange(itemId, field, value) {
      const val = Math.max(0, parseInt(value) || 0);
      if (!appState.inventory[itemId]) return;
      appState.inventory[itemId][field] = val;
      recalculateAndRender(false); // تحديث الحسابات دون إعادة بناء الحقل لفقدان التركيز
    }

    // دالة خطوة سريعة لتعديل العدد بالزر (+ أو -)
    function stepGasField(itemId, field, delta) {
      if (!appState.inventory[itemId]) return;
      const current = appState.inventory[itemId][field] || 0;
      const nextVal = Math.max(0, current + delta);
      appState.inventory[itemId][field] = nextVal;
      
      const input = document.querySelector(`input[data-item="${itemId}"][data-field="${field}"]`);
      if (input) input.value = nextVal;
      
      recalculateAndRender(false);
    }

    // دعم مفتاح Enter للانتقال السريع للحقل التالي
    function handleInputKeydown(e) {
      if (e.key === 'Enter') {
        e.preventDefault();
        const inputs = Array.from(document.querySelectorAll('.table-input'));
        const currentIndex = inputs.indexOf(e.target);
        if (currentIndex > -1 && currentIndex < inputs.length - 1) {
          inputs[currentIndex + 1].focus();
          inputs[currentIndex + 1].select();
        }
      }
    }

    function calculateTotals() {
      let totalInitialFull = 0;
      let totalInitialEmpty = 0;
      let totalAtCompany = 0;
      let totalShift1Sold = 0;
      let totalShift2Sold = 0;
      let totalSoldAll = 0;
      let totalCurrentFull = 0;
      let totalCurrentEmpty = 0;
      let totalAllCylinders = 0;
      let totalGasRevenue = 0;

      CYLINDER_DEFINITIONS.forEach(item => {
        const d = appState.inventory[item.id] || { initFull:0, initEmpty:0, atCompany:0, shift1Sold:0, shift2Sold:0, prepaidSold:0, receivedFull:0, sentEmpty:0, swapOut:0, swapIn:0, price: item.defaultPrice };
        const regSold = (d.shift1Sold || 0) + (d.shift2Sold || 0);
        const totalSoldWithPrepaid = regSold + (d.prepaidSold || 0);

        const curFull = Math.max(0, (d.initFull || 0) + (d.receivedFull || 0) - (totalSoldWithPrepaid + (d.swapOut || 0)));
        const curEmpty = Math.max(0, (d.initEmpty || 0) + regSold + (d.swapIn || 0) - (d.sentEmpty || 0));
        const curAtCompany = Math.max(0, (d.atCompany || 0) + (d.sentEmpty || 0) - (d.receivedFull || 0));
        const itemGrandTotal = curFull + curEmpty + curAtCompany;

        totalInitialFull += (d.initFull || 0);
        totalInitialEmpty += (d.initEmpty || 0);
        totalAtCompany += curAtCompany;
        totalShift1Sold += (d.shift1Sold || 0);
        totalShift2Sold += (d.shift2Sold || 0);
        totalSoldAll += regSold;
        totalCurrentFull += curFull;
        totalCurrentEmpty += curEmpty;
        totalAllCylinders += itemGrandTotal;
        totalGasRevenue += regSold * (d.price || item.defaultPrice);
      });

      // منظمات
      let totalRegSold = 0;
      let totalRegRevenue = 0;
      let totalRegStock = 0;
      REGULATOR_DEFINITIONS.forEach(r => {
        const d = appState.regulators[r.id] || { initStock: 0, added: 0, shift1Sold: 0, shift2Sold: 0, price: r.price };
        const s = (d.shift1Sold || 0) + (d.shift2Sold || 0);
        const rem = Math.max(0, (d.initStock || 0) + (d.added || 0) - s);
        totalRegSold += s;
        totalRegRevenue += s * (d.price || r.price);
        totalRegStock += rem;
      });

      // خرطوش
      const hoseSold = (Number(appState.hose.shift1Meters) || 0) + (Number(appState.hose.shift2Meters) || 0);
      const hoseRemaining = Math.max(0, (Number(appState.hose.initMeters) || 0) + (Number(appState.hose.addedMeters) || 0) - hoseSold);
      const hoseRevenue = hoseSold * (Number(appState.hose.pricePerMeter) || 0);

      const swapFees = appState.swaps
        .filter(s => s.date === appState.currentDate)
        .reduce((sum, s) => sum + (Number(s.differenceFee) || 0), 0);

      const expensesTotal = appState.expenses
        .filter(e => e.date === appState.currentDate)
        .reduce((sum, e) => sum + (Number(e.amount) || 0), 0);

      const todayCols = appState.collections.filter(c => c.date === appState.currentDate);
      const newDebtToday = todayCols.filter(c => !c.paid).reduce((s, c) => s + Number(c.amount), 0);
      const collectedToday = appState.collections
        .filter(c => c.paid && (c.paidDate === appState.currentDate || (!c.paidDate && c.date === appState.currentDate)))
        .reduce((s, c) => s + Number(c.amount), 0);
      const totalAllUnpaid = appState.collections.filter(c => !c.paid).reduce((s, c) => s + Number(c.amount), 0);

      const totalGrossRevenue = totalGasRevenue + totalRegRevenue + hoseRevenue + swapFees;
      const electronic = (Number(appState.payments.bankak) || 0) + (Number(appState.payments.fawry) || 0) + (Number(appState.payments.ocash) || 0);
      const expectedCash = (totalGrossRevenue + collectedToday) - (electronic + newDebtToday + expensesTotal);
      const actualCash = Number(appState.payments.actualCash) || 0;
      const discrepancy = actualCash - expectedCash;
      const netIncome = totalGrossRevenue - expensesTotal;

      return {
        totalInitialFull, totalInitialEmpty, totalAtCompany,
        totalShift1Sold, totalShift2Sold, totalSoldAll,
        totalCurrentFull, totalCurrentEmpty, totalAllCylinders,
        totalGasRevenue,
        totalRegSold, totalRegRevenue, totalRegStock,
        hoseSold, hoseRemaining, hoseRevenue,
        swapFees, expensesTotal,
        newDebtToday, collectedToday, totalAllUnpaid,
        totalGrossRevenue, electronic, expectedCash, actualCash, discrepancy, netIncome
      };
    }

